# ════════════════════════════════════════════════════════════════
# ONEBAR ENVIRONMENT CONFIGURATION EXAMPLE
# ════════════════════════════════════════════════════════════════
#
# IMPORTANT SECURITY WARNING:
# Secrets must NEVER be prefixed with VITE_ or committed to source control.
# Add these environment variables in your Vercel Project Settings -> Environment Variables.

# 1. Resend API Secret Key (Obtain from https://resend.com/api-keys)
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# 2. Recipient Email Inbox (Where contact form inquiries will be sent)
CONTACT_EMAIL=onebar.help@gmail.com

# 3. Verified Sender Domain/Email configured in Resend
CONTACT_FROM_EMAIL=OneBar <onboarding@resend.dev>

